# NEXUS STATUS environment variables
# Copy to .env.local and fill in real values. Never commit real values.

# --- Supabase (required for live data & auth) -----------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon/publishable key (safe to expose; protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) -----------------
# Used ONLY by local scripts (seed, create-admin, verify). Never shipped to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application ----------------------------------------------------------
# Public site URL (used for docs/links). Vercel provides one automatically;
# set this to your deployed URL after first deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Polling fallback interval in milliseconds (minimum 5000). Default 30000.
NEXT_PUBLIC_POLL_INTERVAL_MS=30000
# Force demo data even in production builds (do NOT use for real deployments).
# NEXT_PUBLIC_FORCE_DEMO=false
